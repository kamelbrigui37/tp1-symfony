{% extends 'base.html.twig' %}

{% block title %}Gestion des articles{% endblock %}

{% block body %}

    <style>
        /* Page heading */
        .page-heading {
            margin-bottom: 30px;
        }

        .page-heading h1 {
            font-size: 1.8rem;
            font-weight: 700;
            color: #1e293b;
        }

        .page-heading p {
            color: #64748b;
            margin-bottom: 0;
        }

        /* Statistics cards */
        .stat-card {
            border: none;
            border-radius: 14px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
            transition: transform 0.2s ease;
        }

        .stat-card:hover {
            transform: translateY(-3px);
        }

        /* Articles grid */
        .articles-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 24px;
        }

        /* Article card */
        .article-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            overflow: hidden;
            height: 100%;
            display: flex;
            flex-direction: column;
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

        .article-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(15, 23, 42, 0.09);
        }

        /* Card header */
        .article-card-header {
            padding: 22px 22px 16px;
            background: linear-gradient(135deg, #eef2ff, #f8fafc);
            border-bottom: 1px solid #e2e8f0;
        }

        .article-icon {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: #e0e7ff;
            color: #4f46e5;
            font-size: 1.5rem;
            flex-shrink: 0;
        }

        .article-id {
            font-size: 0.8rem;
            color: #64748b;
            font-weight: 600;
        }

        /* Card body */
        .article-card-body {
            padding: 22px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .article-title {
            font-size: 1.15rem;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 18px;
            overflow-wrap: anywhere;
        }

        .article-title a {
            color: inherit;
            text-decoration: none;
        }

        .article-title a:hover {
            color: #4f46e5;
        }

        .article-info {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 15px;
            color: #64748b;
            font-size: 0.9rem;
        }

        .author-avatar {
            width: 36px;
            height: 36px;
            display: inline-flex;
            justify-content: center;
            align-items: center;
            flex-shrink: 0;
            border-radius: 50%;
            background: #e0e7ff;
            color: #3730a3;
            font-weight: 700;
        }

        .article-status {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            width: fit-content;
            border-radius: 30px;
            padding: 7px 12px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .status-published {
            background: #dcfce7;
            color: #166534;
        }

        .status-draft {
            background: #fef3c7;
            color: #92400e;
        }

        /* Card footer */
        .article-card-footer {
            padding: 16px 22px;
            border-top: 1px solid #f1f5f9;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: auto;
        }

        .article-card-footer .btn {
            border-radius: 8px;
        }

        .article-card-footer .btn-view {
            flex: 1;
        }

        /* Empty state */
        .empty-state {
            padding: 60px 20px;
            text-align: center;
            background: #ffffff;
            border: 1px dashed #cbd5e1;
            border-radius: 16px;
        }

        .empty-state-icon {
            font-size: 4rem;
            color: #94a3b8;
        }

        /* Responsive */
        @media (max-width: 576px) {
            .page-heading h1 {
                font-size: 1.45rem;
            }

            .articles-grid {
                grid-template-columns: 1fr;
            }

            .article-card-footer {
                padding: 14px;
            }
        }
    </style>

    {# Page heading #}
    <div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1>
                <i class="bi bi-newspaper me-2" style="color: #4f46e5;"></i>
                Gestion des articles
            </h1>

            <p>Gérez vos articles, leurs auteurs et leur publication.</p>
        </div>

        <a href="{{ path('app_article_nouveau') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg me-2"></i>
            Nouvel article
        </a>
    </div>

    {# Statistics #}
    {% set totalArticles = articles|length %}
    {% set articlesPublies = articles|filter(a => a.publie)|length %}
    {% set articlesBrouillons = totalArticles - articlesPublies %}

    <div class="row g-3 mb-4">

        {# Total articles #}
        <div class="col-md-4">
            <div class="card stat-card h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-2">Total des articles</p>
                        <h2 class="mb-0 fw-bold">{{ totalArticles }}</h2>
                    </div>

                    <div class="rounded-3 p-3"
                         style="background:#eef2ff;color:#4f46e5;">
                        <i class="bi bi-files fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        {# Published articles #}
        <div class="col-md-4">
            <div class="card stat-card h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-2">Articles publiés</p>
                        <h2 class="mb-0 fw-bold">{{ articlesPublies }}</h2>
                    </div>

                    <div class="rounded-3 p-3"
                         style="background:#dcfce7;color:#15803d;">
                        <i class="bi bi-check-circle fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        {# Draft articles #}
        <div class="col-md-4">
            <div class="card stat-card h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-2">Brouillons</p>
                        <h2 class="mb-0 fw-bold">{{ articlesBrouillons }}</h2>
                    </div>

                    <div class="rounded-3 p-3"
                         style="background:#fef3c7;color:#b45309;">
                        <i class="bi bi-pencil-square fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    {# Articles section #}
    <div class="card border-0 shadow-sm" style="border-radius:16px;">

        {# Section header #}
        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2 py-3"
             style="border-radius:16px 16px 0 0;">

            <h5 class="mb-0 fw-bold">
                <i class="bi bi-grid me-2" style="color:#4f46e5;"></i>
                Tous les articles
            </h5>

            <span class="badge rounded-pill text-bg-light border px-3 py-2">
                {{ totalArticles }} article(s)
            </span>
        </div>

        <div class="card-body p-4">

            {% if articles is empty %}

                {# Empty state #}
                <div class="empty-state">
                    <i class="bi bi-inbox empty-state-icon"></i>

                    <h4 class="mt-3 fw-bold">Aucun article pour le moment</h4>

                    <p class="text-muted mb-4">
                        Commencez par créer votre premier article.
                    </p>

                    <a href="{{ path('app_article_nouveau') }}"
                       class="btn btn-primary">
                        <i class="bi bi-plus-lg me-2"></i>
                        Créer un article
                    </a>
                </div>

            {% else %}

                {# Articles displayed as cards #}
                <div class="articles-grid">

                    {% for article in articles %}

                        <div class="article-card">

                            {# Card header #}
                            <div class="article-card-header">

                                <div class="d-flex justify-content-between align-items-center gap-2">

                                    <div class="article-icon">
                                        <i class="bi bi-file-earmark-text"></i>
                                    </div>

                                    <span class="article-id">
                                        ARTICLE #{{ article.id }}
                                    </span>

                                </div>

                            </div>

                            {# Card body #}
                            <div class="article-card-body">

                                {# Title #}
                                <h3 class="article-title">
                                    <a href="{{ path('app_article_detail', {'id': article.id}) }}">
                                        {{ article.titre }}
                                    </a>
                                </h3>

                                {# Author #}
                                <div class="article-info">

                                    <span class="author-avatar">
                                        {{ article.auteur|default('?')|first|upper }}
                                    </span>

                                    <div>
                                        <div class="text-muted small">Auteur</div>
                                        <div class="fw-semibold text-dark">
                                            {{ article.auteur|default('Inconnu') }}
                                        </div>
                                    </div>

                                </div>

                                {# Creation date #}
                                <div class="article-info">
                                    <i class="bi bi-calendar3"></i>

                                    <span>
                                        {% if article.dateCreation %}
                                            {{ article.dateCreation|date('d/m/Y') }}
                                        {% else %}
                                            Date non disponible
                                        {% endif %}
                                    </span>
                                </div>

                                {# Publication status #}
                                <div class="mt-2">

                                    {% if article.publie %}

                                        <span class="article-status status-published">
                                            <i class="bi bi-check-circle"></i>
                                            Publié
                                        </span>

                                    {% else %}

                                        <span class="article-status status-draft">
                                            <i class="bi bi-pencil-square"></i>
                                            Brouillon
                                        </span>

                                    {% endif %}

                                </div>

                            </div>

                            {# Card footer: actions #}
                            <div class="article-card-footer">

                                <a href="{{ path('app_article_detail', {'id': article.id}) }}"
                                   class="btn btn-sm btn-outline-primary btn-view">
                                    <i class="bi bi-eye me-1"></i>
                                    Voir
                                </a>

                                <a href="{{ path('app_article_modifier', {'id': article.id}) }}"
                                   class="btn btn-sm btn-outline-secondary"
                                   title="Modifier l'article"
                                   aria-label="Modifier l'article {{ article.titre }}">
                                    <i class="bi bi-pencil"></i>
                                </a>

                            </div>

                        </div>

                    {% endfor %}

                </div>

                {# Footer information #}
                <div class="border-top mt-4 pt-3">
                    <p class="text-muted small mb-0">
                        <i class="bi bi-database me-1"></i>
                        {{ totalArticles }} article(s) enregistré(s) dans la base de données.
                    </p>
                </div>

            {% endif %}

        </div>
    </div>

{% endblock %}
