<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}Admin Dashboard{% endblock %} | Symfony Manager</title>

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>📰</text></svg>">

    {# Bootstrap 5 #}
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    {# Bootstrap Icons #}
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <style>
        :root {
            --primary: #4f46e5;
            --primary-dark: #3730a3;
            --sidebar-bg: #111827;
            --page-bg: #f5f7fb;
            --text-dark: #1f2937;
            --text-muted: #6b7280;
            --border-color: #e5e7eb;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--page-bg);
            color: var(--text-dark);
            font-family: Inter, -apple-system, BlinkMacSystemFont,
                         "Segoe UI", sans-serif;
        }

        /* Sidebar */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 250px;
            height: 100vh;
            padding: 28px 18px;
            background: var(--sidebar-bg);
            color: white;
            z-index: 1000;
            overflow-y: auto;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 10px 30px;
            color: white;
            font-size: 21px;
            font-weight: 750;
            text-decoration: none;
        }

        .brand-icon {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 42px;
            height: 42px;
            border-radius: 13px;
            background: var(--primary);
            font-size: 22px;
        }

        .sidebar-label {
            margin: 15px 12px 10px;
            color: #9ca3af;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 13px;
            margin-bottom: 6px;
            padding: 12px 14px;
            border-radius: 10px;
            color: #cbd5e1;
            text-decoration: none;
            font-size: 14px;
            transition: all 0.2s ease;
        }

        .sidebar-link i {
            font-size: 18px;
        }

        .sidebar-link:hover,
        .sidebar-link.active {
            background: #312e81;
            color: white;
        }

        /* Main layout */
        .main-wrapper {
            min-height: 100vh;
            margin-left: 250px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            min-height: 76px;
            padding: 16px 35px;
            background: white;
            border-bottom: 1px solid var(--border-color);
        }

        .topbar-title {
            margin: 0;
            font-size: 19px;
            font-weight: 700;
        }

        .topbar-subtitle {
            margin-top: 4px;
            color: var(--text-muted);
            font-size: 12px;
        }

        .profile-badge {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #e0e7ff;
            color: var(--primary-dark);
            font-weight: 700;
        }

        .page-content {
            padding: 32px 35px;
        }

        .page-heading {
            margin-bottom: 25px;
        }

        .page-heading h1 {
            margin-bottom: 7px;
            font-size: 28px;
            font-weight: 750;
        }

        .page-heading p {
            margin-bottom: 0;
            color: var(--text-muted);
        }

        /* Cards and tables */
        .card {
            border: 1px solid #edf0f5;
            border-radius: 16px;
            box-shadow: 0 4px 18px rgba(15, 23, 42, 0.035);
        }

        .card-header {
            padding: 20px 22px;
            background: white;
            border-bottom: 1px solid #edf0f5;
            border-radius: 16px 16px 0 0 !important;
            font-weight: 700;
        }

        .card-body {
            padding: 22px;
        }

        .table {
            margin-bottom: 0;
            vertical-align: middle;
        }

        .table thead th {
            padding: 15px;
            background: #f8fafc;
            color: #64748b;
            border-bottom: 1px solid var(--border-color);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.7px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .table tbody td {
            padding: 15px;
            border-color: #f0f2f6;
        }

        .table tbody tr:hover {
            background: #fafbff;
        }

        /* Buttons */
        .btn {
            border-radius: 9px;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .btn-primary {
            background: var(--primary);
            border-color: var(--primary);
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            border-color: var(--primary-dark);
        }

        .btn-sm {
            border-radius: 7px;
        }

        /* Forms */
        .form-label {
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 650;
        }

        .form-control,
        .form-select {
            min-height: 44px;
            border: 1px solid #dfe3eb;
            border-radius: 9px;
            box-shadow: none !important;
        }

        textarea.form-control {
            min-height: 120px;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1) !important;
        }

        /* Alerts */
        .alert {
            border: none;
            border-radius: 10px;
        }

        /* Responsive layout */
        @media (max-width: 900px) {
            .sidebar {
                width: 205px;
                padding: 20px 12px;
            }

            .main-wrapper {
                margin-left: 205px;
            }

            .page-content {
                padding: 25px 18px;
            }

            .topbar {
                padding: 16px 20px;
            }
        }

        @media (max-width: 650px) {
            .sidebar {
                position: relative;
                width: 100%;
                height: auto;
                padding: 12px;
            }

            .brand {
                padding-bottom: 12px;
            }

            .sidebar-label {
                display: none;
            }

            .sidebar nav {
                display: flex;
                flex-wrap: wrap;
                gap: 5px;
            }

            .sidebar-link {
                margin: 0;
                padding: 9px 11px;
            }

            .main-wrapper {
                margin-left: 0;
            }

            .topbar {
                min-height: 65px;
                padding: 14px 18px;
            }

            .page-content {
                padding: 22px 14px;
            }

            .page-heading h1 {
                font-size: 23px;
            }
        }
    </style>

    {% block stylesheets %}{% endblock %}

    {% block javascripts %}
        {% block importmap %}
            {{ importmap('app') }}
        {% endblock %}
    {% endblock %}

    {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}

    {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
    {% endif %}

</head>

<body>

    {# Sidebar #}
    <aside class="sidebar">

        <a href="{{ path('app_articles') }}" class="brand">
            <span class="brand-icon">
                <i class="bi bi-layers-fill"></i>
            </span>

            <span>
                Symfony<span style="color:#818cf8">Manager</span>
            </span>
        </a>

        <div class="sidebar-label">Menu principal</div>

        <nav>

            <a href="{{ path('app_articles') }}" class="sidebar-link">
                <i class="bi bi-grid-1x2"></i>
                <span>Articles</span>
            </a>

            {% if is_granted('ROLE_USER') %}

                <a href="{{ path('app_article_nouveau') }}" class="sidebar-link">
                    <i class="bi bi-plus-circle"></i>
                    <span>Nouvel article</span>
                </a>

            {% endif %}

            {% if is_granted('ROLE_ADMIN') %}

                <a href="{{ path('app_categories') }}" class="sidebar-link">
                    <i class="bi bi-folder2-open"></i>
                    <span>Catégories</span>
                </a>

                <a href="{{ path('app_categorie_nouvelle') }}" class="sidebar-link">
                    <i class="bi bi-folder-plus"></i>
                    <span>Nouvelle catégorie</span>
                </a>

            {% endif %}

            {% if app.user %}

                <a href="{{ path('app_logout') }}" class="sidebar-link">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Déconnexion</span>
                </a>

            {% else %}

                <a href="{{ path('app_login') }}" class="sidebar-link">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Connexion</span>
                </a>

                <a href="{{ path('app_register') }}" class="sidebar-link">
                    <i class="bi bi-person-plus"></i>
                    <span>Inscription</span>
                </a>

            {% endif %}

        </nav>

        <div class="sidebar-label mt-4">Application</div>

        <div class="sidebar-link" style="cursor:default">
            <i class="bi bi-code-slash"></i>
            <span>Symfony TP</span>
        </div>

    </aside>

    {# Main content #}
    <div class="main-wrapper">

        {# Topbar #}
        <header class="topbar">

            <div>
                <h2 class="topbar-title">
                    Gestion de contenu
                </h2>

                <div class="topbar-subtitle">
                    Administration de vos articles et catégories
                </div>
            </div>

            {# User profile #}
            {% if app.user %}

                <div class="d-flex align-items-center gap-3">

                    <div class="text-end">
                        <div class="fw-semibold">
                            {{ app.user.pseudo }}
                        </div>

                        <small class="text-muted">
                            {{ app.user.email }}
                        </small>
                    </div>

                    <div class="profile-badge" title="{{ app.user.email }}">
                        {{ app.user.pseudo|first|upper }}
                    </div>

                </div>

            {% else %}

                <div class="profile-badge">
                    <i class="bi bi-person"></i>
                </div>

            {% endif %}

        </header>

        {# Page content #}
        <main class="page-content">

            {# Success messages #}
            {% for message in app.flashes('success') %}

                <div class="alert alert-success alert-dismissible fade show" role="alert">

                    <i class="bi bi-check-circle-fill me-2"></i>

                    {{ message }}

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>

            {% endfor %}

            {# Danger messages #}
            {% for message in app.flashes('danger') %}

                <div class="alert alert-danger alert-dismissible fade show" role="alert">

                    <i class="bi bi-exclamation-triangle-fill me-2"></i>

                    {{ message }}

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>

            {% endfor %}

            {% block body %}{% endblock %}

        </main>

    </div>

    {# Bootstrap JavaScript #}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
