{% extends 'base.html.twig' %}

{% block title %}Gestion des tâches{% endblock %}

{% block body %}
    <h1 class="mb-4">Ma To-Do List</h1>

    <a href="{{ path('app_tache_ajouter') }}"
       class="btn btn-primary mb-4">
        + Ajouter une tâche
    </a>

    {% if taches is empty %}
        <div class="alert alert-info">
            Aucune tâche enregistrée.
        </div>
    {% else %}
        <div class="list-group">
            {% for tache in taches %}
                <div class="list-group-item">
                    <h5>
                        {% if tache.terminee %}
                            <span style="text-decoration: line-through;">
                                {{ tache.titre }}
                            </span>
                        {% else %}
                            {{ tache.titre }}
                        {% endif %}
                    </h5>

                    <p>{{ tache.description }}</p>

                    <small class="text-muted">
                        Créée le {{ tache.dateCreation|date('d/m/Y H:i') }}
                    </small>

                    <p class="mt-2">
                        {% if tache.terminee %}
                            <span class="badge bg-success">Terminée</span>
                        {% else %}
                            <span class="badge bg-warning text-dark">
                                En cours
                            </span>
                        {% endif %}
                    </p>

                    <a href="{{ path('app_tache_detail', {
                        id: tache.id
                    }) }}" class="btn btn-sm btn-outline-primary">
                        Détails
                    </a>

                    {% if not tache.terminee %}
                        <form
                            method="post"
                            action="{{ path('app_tache_terminer', {
                                id: tache.id
                            }) }}"
                            class="d-inline"
                        >
                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token('terminer' ~ tache.id) }}"
                            >

                            <button class="btn btn-sm btn-success">
                                Terminer
                            </button>
                        </form>
                    {% endif %}
                </div>
            {% endfor %}
        </div>

        <p class="mt-3 text-muted">
            {{ taches|length }} tâche(s) au total.
        </p>
    {% endif %}
{% endblock %}
